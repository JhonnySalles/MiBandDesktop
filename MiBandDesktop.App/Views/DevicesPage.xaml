<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MiBandDesktop_App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MiBandDesktop.App.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Dispositivos" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
            <TextBlock Text="Gerenciamento de pulseiras Mi Band cadastradas e scanner Bluetooth LE nativo do Windows"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="13" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#3B82F6" FontSize="12" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Scanner BLE -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Scanner Bluetooth (BLE)" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Localize sua pulseira próxima para emparelhamento e selecione-a na lista."
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="12" />
                    </StackPanel>

                    <Button Grid.Row="1" Content="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToScanTextConverter}}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleScanCommand}" />

                    <!-- Lista de dispositivos descobertos -->
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedDiscoveredDevice, Mode=TwoWay}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscoveredBleDevice">
                                <Grid Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#22C55E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Visibility="{x:Bind IsMiBand, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Mi Band" FontSize="10" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Configurar Dispositivo -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Configurar Dispositivo" FontWeight="SemiBold" FontSize="16" />
                        <TextBox Header="Nome da Pulseira" Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}" />
                        <TextBox Header="Endereço MAC" PlaceholderText="ex: E4:AA:EC:XX:XX:XX" Text="{x:Bind ViewModel.MacAddress, Mode=TwoWay}" />
                        <TextBox Header="Auth Key (32 hex chars)" PlaceholderText="Chave de autenticação Huami (opcional)" Text="{x:Bind ViewModel.AuthKey, Mode=TwoWay}" />
                        <Button Content="Salvar Pulseira Ativa" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveDeviceCommand}" />

                        <MenuFlyoutSeparator />

                        <TextBlock Text="Pulseiras Cadastradas" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" />
                        <ListView ItemsSource="{x:Bind ViewModel.SavedDevices, Mode=OneWay}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Height="140">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,4">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
