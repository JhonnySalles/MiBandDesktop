<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MiBandDesktop_App.Views.DatabaseSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MiBand Desktop — Configuração do Banco de Dados"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MiBand Desktop — Configuração do Banco de Dados">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/WindowIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="32" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="Configuração da Conexão MySQL" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock Text="Informe as credenciais do servidor MySQL para inicialização e migração automática (Flyway)."
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="13" />
                </StackPanel>

                <!-- Alerta de Status -->
                <Border x:Name="AlertBorder" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtStatusTitle" Text="Conexão não configurada ou servidor offline" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <TextBlock x:Name="TxtStatusDetail" Text="Por favor, configure os dados de acesso abaixo para que o programa crie as tabelas e inicie o serviço."
                                   FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Formulário de Conexão -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Parâmetros do Servidor" FontWeight="SemiBold" FontSize="16" />

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Host & Porta -->
                            <TextBox x:Name="TxtHost" Grid.Row="0" Grid.Column="0" Header="Host / Servidor" Text="localhost" />
                            <TextBox x:Name="TxtPort" Grid.Row="0" Grid.Column="1" Header="Porta" Text="3306" />

                            <!-- Schema -->
                            <TextBox x:Name="TxtDatabase" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Nome do Banco de Dados" Text="miband_desktop" />

                            <!-- Usuário & Senha -->
                            <TextBox x:Name="TxtUsername" Grid.Row="2" Grid.Column="0" Header="Usuário" Text="root" />
                            <PasswordBox x:Name="TxtPassword" Grid.Row="2" Grid.Column="1" Header="Senha" />

                            <!-- SSL Mode & Auto Create -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
                                <ComboBox x:Name="CmbSslMode" Header="Modo SSL" SelectedIndex="0" Width="180">
                                    <ComboBoxItem Content="Preferred" />
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="Required" />
                                </ComboBox>

                                <ToggleSwitch x:Name="SwAutoCreate" Header="Criar banco se não existir" IsOn="True" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Console de Migrações & Ações -->
                <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log de Migrações Flyway" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnTestConnection" Content="Testar Conexão" Click="BtnTestConnection_Click" />
                                <Button x:Name="BtnSaveAndMigrate" Content="Salvar &amp; Iniciar Programa" Style="{ThemeResource AccentButtonStyle}" Click="BtnSaveAndMigrate_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="TxtLogOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                                 FontFamily="Consolas" FontSize="11" Text="[INFO] Aguardando teste de conexão com o MySQL..." />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

