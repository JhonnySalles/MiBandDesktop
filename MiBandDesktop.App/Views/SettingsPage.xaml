<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MiBandDesktop_App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Configurações do Aplicativo" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
            <TextBlock Text="Comportamento no Windows, execução em segundo plano e banco de dados"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="13" />
        </StackPanel>

        <!-- Execução no Windows -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Text="Inicialização &amp; Segundo Plano" FontWeight="SemiBold" FontSize="16" />
                <ToggleSwitch Header="Iniciar automaticamente junto com o Windows" IsOn="True" />
                <ToggleSwitch Header="Iniciar minimizado na bandeja do sistema (System Tray)" IsOn="True" />
                <ToggleSwitch Header="Minimizar para a bandeja ao fechar a janela principal" IsOn="True" />
            </StackPanel>
        </Border>

        <!-- Banco de Dados e Armazenamento -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Armazenamento Local (SQLite)" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="%LocalAppData%\MiBandDesktop\miband.db" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="12" />
                <Button Content="Abrir Pasta de Dados" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

