<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MiBandDesktop_App.Views.WeatherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Clima &amp; Integrações" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
            <TextBlock Text="Configuração de provedores meteorológicos e transmissão automática para a pulseira"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" FontSize="13" />
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Provedor Meteorológico" FontWeight="SemiBold" FontSize="16" />
                <ComboBox Header="Provedor" SelectedIndex="0">
                    <ComboBoxItem Content="Open-Meteo (Gratuito / Sem Token)" />
                    <ComboBoxItem Content="OpenWeatherMap" />
                    <ComboBoxItem Content="WeatherAPI" />
                </ComboBox>
                <TextBox Header="Cidade de Referência" Text="São Paulo" />
                <Button Content="Salvar Configurações de Clima" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

