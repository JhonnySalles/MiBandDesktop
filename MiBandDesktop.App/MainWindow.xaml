<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MiBandDesktop_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MiBandDesktop_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MiBand Desktop"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MiBand Desktop">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/WindowIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed"
                        ItemInvoked="NavView_ItemInvoked" SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded" PaneOpened="NavView_PaneOpened" PaneClosed="NavView_PaneClosed">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Contact" Content="Dashboard" Tag="DashboardPage" />
                <NavigationViewItem Icon="Bullets" Content="Histórico" Tag="HistoryPage" />
                <NavigationViewItem Icon="FourBars" Content="Dispositivos" Tag="DevicesPage" />
                <NavigationViewItem Icon="World" Content="Clima" Tag="WeatherPage" />
                <NavigationViewItem Icon="Clock" Content="Configurações da Pulseira" Tag="BandSettingsPage" />
                <NavigationViewItem Icon="Repair" Content="Laboratório de Testes" Tag="TestLabPage" />
            </NavigationView.MenuItems>
            
            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Margin="8,4,8,8">
                    <!-- Status Card Compacto no Rodapé -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C55E" />
                                <TextBlock x:Name="TxtStatusDevice" Text="Mi Smart Band 6" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="TxtStatusMac" Text="Conectado / Monitorando" FontSize="10"
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
